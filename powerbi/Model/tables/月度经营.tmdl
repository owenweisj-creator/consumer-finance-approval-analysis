table 月度经营

	column 月份
		dataType: string
		summarizeBy: none
		sourceColumn: 月份

	column 月份序号
		dataType: int64
		summarizeBy: none
		sourceColumn: 月份序号

	column 进件量
		dataType: int64
		summarizeBy: sum
		sourceColumn: 进件量

	column 审批通过量
		dataType: int64
		summarizeBy: sum
		sourceColumn: 审批通过量

	column 实际用信量
		dataType: int64
		summarizeBy: sum
		sourceColumn: 实际用信量

	column 月度通过率
		dataType: double
		summarizeBy: none
		sourceColumn: 审批通过率

	column 月度用信率
		dataType: double
		summarizeBy: none
		sourceColumn: 用信率

	column 审批金额
		dataType: double
		summarizeBy: sum
		sourceColumn: 审批金额

	column 月度件均
		dataType: double
		summarizeBy: none
		sourceColumn: 件均

	measure '进件量合计' = SUM('月度经营'[进件量])
		formatString: #,0
		displayFolder: 核心指标

	measure '审批通过量合计' = SUM('月度经营'[审批通过量])
		formatString: #,0
		displayFolder: 核心指标

	measure '整体审批通过率' = DIVIDE(SUM('月度经营'[审批通过量]), SUM('月度经营'[进件量]))
		formatString: 0.00%
		displayFolder: 核心指标

	measure '整体用信率' = DIVIDE(SUM('月度经营'[实际用信量]), SUM('月度经营'[审批通过量]))
		formatString: 0.00%
		displayFolder: 核心指标

	measure '审批金额合计' = SUM('月度经营'[审批金额])
		formatString: #,0.00
		displayFolder: 核心指标

	measure '整体件均' = DIVIDE([审批金额合计], SUM('月度经营'[实际用信量]))
		formatString: #,0.00
		displayFolder: 核心指标

	measure '最新月进件量' = VAR 最新月 = CALCULATE(MAX('月度经营'[月份]), REMOVEFILTERS('月度经营')) RETURN CALCULATE([进件量合计], REMOVEFILTERS('月度经营'), '月度经营'[月份] = 最新月)
		formatString: #,0
		displayFolder: 最新月

	measure '最新月审批通过率' = VAR 最新月 = CALCULATE(MAX('月度经营'[月份]), REMOVEFILTERS('月度经营')) RETURN CALCULATE([整体审批通过率], REMOVEFILTERS('月度经营'), '月度经营'[月份] = 最新月)
		formatString: 0.00%
		displayFolder: 最新月

	measure '最新月用信率' = VAR 最新月 = CALCULATE(MAX('月度经营'[月份]), REMOVEFILTERS('月度经营')) RETURN CALCULATE([整体用信率], REMOVEFILTERS('月度经营'), '月度经营'[月份] = 最新月)
		formatString: 0.00%
		displayFolder: 最新月

	measure '最新月审批金额' = VAR 最新月 = CALCULATE(MAX('月度经营'[月份]), REMOVEFILTERS('月度经营')) RETURN CALCULATE([审批金额合计], REMOVEFILTERS('月度经营'), '月度经营'[月份] = 最新月)
		formatString: #,0.00
		displayFolder: 最新月

	measure '最新月件均' = VAR 最新月 = CALCULATE(MAX('月度经营'[月份]), REMOVEFILTERS('月度经营')) RETURN CALCULATE([整体件均], REMOVEFILTERS('月度经营'), '月度经营'[月份] = 最新月)
		formatString: #,0.00
		displayFolder: 最新月

	partition '月度经营' = m
		mode: import
		source =
			let
			    Source = Csv.Document(File.Contents("E:/ai数据分析工作/consumer-finance-approval-analysis/powerbi/data/月度经营.csv"),[Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
			    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
			    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers",{{"月份", type text}, {"月份序号", Int64.Type}, {"进件量", Int64.Type}, {"审批通过量", Int64.Type}, {"实际用信量", Int64.Type}, {"审批通过率", type number}, {"用信率", type number}, {"审批金额", type number}, {"件均", type number}})
			in
			    #"Changed Type"
